# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_API_TOKEN: Meta WhatsApp Cloud API System User / Access Token
# Obtained from Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Business Phone Number ID
# Obtained from Meta for Developers -> WhatsApp -> API Setup (Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_BUSINESS_ACCOUNT_ID: (Optional) Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WHATSAPP_TEMPLATE_NAME: (Optional) Approved Authentication Message Template Name on Meta
# If omitted, standard WhatsApp text message with 5-minute validity warning is sent.
WHATSAPP_TEMPLATE_NAME=

# WHATSAPP_TEMPLATE_LANG: (Optional) Language code for WhatsApp template (defaults to en_US)
WHATSAPP_TEMPLATE_LANG=en_US

# BREVO_API_KEY: Brevo (formerly Sendinblue) API v3 key for candidate email OTP dispatch
# Generated from Brevo Dashboard (app.brevo.com) -> SMTP & API -> API Keys (Format: xkeysib-...)
BREVO_API_KEY=

# BREVO_SENDER_EMAIL: Sender email verified in your Brevo account
# e.g. info@arudhraconsultancy.com or arudhramanikandan@gmail.com
BREVO_SENDER_EMAIL=info@arudhraconsultancy.com

# BREVO_SENDER_NAME: Sender name displayed on outgoing email OTPs
BREVO_SENDER_NAME=ARUDHRA CONSULTANCY
